# Copie para .env.local e preencha com as chaves do SEU projeto Supabase
# (Project Settings → API). Sem estas duas variáveis o app roda com dados em memória.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Só para scripts locais (npm run seed). Nunca use em código do navegador nem commite.
SUPABASE_SECRET_KEY=
# E-mail de um usuário já convidado no Supabase, que vira admin do escritório de demonstração no seed.
SEED_ADMIN_EMAIL=

# URL pública do app, usada nos links de e-mail (redefinir senha).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
